		summarizeBy: none
		sourceColumn: Gender

	column Phone
		dataType: string
		summarizeBy: none
		sourceColumn: Phone

	column Email
		dataType: string
		summarizeBy: none
		sourceColumn: Email

	column CustomerCity
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerCity

	column State
		dataType: string
		summarizeBy: none
		sourceColumn: State

	column Pincode
		dataType: string
		summarizeBy: none
		sourceColumn: Pincode

	column RegistrationDate
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: RegistrationDate

	column Membership
		dataType: string
		summarizeBy: none
		sourceColumn: Membership

	column TotalOrders
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: TotalOrders

	column PreferredCuisine
		dataType: string
		summarizeBy: none
		sourceColumn: PreferredCuisine

	column Orders
