	column CLVBandOrder
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: CLVBandOrder

	partition dim_customer = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataPath & "\dim_customer.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"CustomerID", Int64.Type}, {"Name", type text}, {"Age", Int64.Type}, {"Gender", type text}, {"Phone", type text}, {"Email", type text}, {"CustomerCity", type text}, {"State", type text}, {"Pincode", type text}, {"RegistrationDate", type date}, {"Membership", type text}, {"TotalOrders", Int64.Type}, {"PreferredCuisine", type text}, {"Orders", Int64.Type}, {"CompletedOrders", type number}, {"CLV", type number}, {"FirstOrderDate", type date}, {"LastOrderDate", type date}, {"DaysSinceLastOrder", type number}, {"Segment", type text}, {"CustomerType", type text}, {"CLVBand", type text}, {"CLVBandOrder", Int64.Type}}, "en-US")
				in
					Typed
