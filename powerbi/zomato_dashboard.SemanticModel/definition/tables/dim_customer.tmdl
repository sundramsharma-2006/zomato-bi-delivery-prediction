table dim_customer

	column CustomerID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: CustomerID

	column Name
		dataType: string
		summarizeBy: none
		sourceColumn: Name

	column Age
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Age

	column Gender
