		summarizeBy: none
		sourceColumn: CompletedOrders

	column CLV
		dataType: double
		summarizeBy: none
		sourceColumn: CLV

	column FirstOrderDate
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: FirstOrderDate

	column LastOrderDate
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: LastOrderDate

	column DaysSinceLastOrder
		dataType: double
		summarizeBy: none
		sourceColumn: DaysSinceLastOrder

	column Segment
		dataType: string
		summarizeBy: none
		sourceColumn: Segment

	column CustomerType
